# Copy to .env and fill in. Never commit or zip your real .env.
FRED_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_PROVIDER=groq

DASHBOARD_PORT=8501
MT5_SYMBOL=XAUUSDb
BROKER_TZ=Europe/Athens
CALENDAR_TZ=UTC
CALENDAR_CURRENCIES=USD,ALL
SESSION_MODE=auto
SESSION_START_UTC=13
SESSION_END_UTC=17

# --- liquidity / cost (set EST_COST_USD to your real commission+slippage per oz)
MAX_SPREAD_USD=0.60
SPREAD_P95_MULT=2.0
MAX_SPREAD_ATR=0.12
EST_COST_USD=0.00
MAX_QUOTE_AGE_SEC=60

# --- engine (v3)
ANALYSIS_TF=M15
MACRO_MODE=score          # off | score (soft factor) | gate (v2 behaviour: hard direction filter)
MIN_CONF_TREND=70
MIN_CONF_RANGE=72
MIN_BOX_CONF=75
MIN_RR_TREND=2.0
MIN_RR_RANGE=1.8
TRANSITION_MIN_CONF=90
OFFSESSION_CONF_BUMP=5
POSTNEWS_CONF_BUMP=8

# --- selective LLM
LLM_MODE=manual           # off | manual | auto
LLM_MIN_CONF=80
LLM_MAX_PER_HOUR=3
LLM_MAX_PER_DAY=12
LLM_VETO=1
